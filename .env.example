# ==========================================
# BACKEND CONFIGURATION (Render / server/.env)
# ==========================================
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/leaddesk?retryWrites=true&w=majority
JWT_SECRET=super_secret_jwt_key_leaddesk_2026
# CLIENT_URL supports comma-separated URLs for Vercel frontend and local testing
CLIENT_URL=https://leadesk.vercel.app,http://localhost:5173

# Admin Initial Seed Credentials
ADMIN_EMAIL=admin@leaddesk.com
ADMIN_PASSWORD=SuperSecurePassword123!

# ==========================================
# FRONTEND CONFIGURATION (Vercel / client/.env)
# ==========================================
# For Vercel production deployment:
VITE_API_URL=https://leaddesk-zue0.onrender.com/api

# For local development:
# VITE_API_URL=http://localhost:5000/api
